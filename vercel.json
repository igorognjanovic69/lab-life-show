{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "lab-life-show.vercel.app" }],
      "destination": "https://lablifehub.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.lablifehub.com" }],
      "destination": "https://lablifehub.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/index.html" },
    { "source": "/about/(.*)", "destination": "/index.html" },
    { "source": "/research", "destination": "/index.html" },
    { "source": "/research/(.*)", "destination": "/index.html" },
    { "source": "/podcast", "destination": "/index.html" },
    { "source": "/podcast/(.*)", "destination": "/index.html" },
    { "source": "/academy", "destination": "/index.html" },
    { "source": "/academy/(.*)", "destination": "/index.html" },
    { "source": "/book", "destination": "/index.html" },
    { "source": "/book/(.*)", "destination": "/index.html" },
    { "source": "/reviews", "destination": "/index.html" },
    { "source": "/reviews/(.*)", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/contact/(.*)", "destination": "/index.html" }
  ]
}
